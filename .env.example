# Application
DATABASE_URL=postgresql://user:password@localhost:5432/life_stack
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=life-stack-api
JWT_AUDIENCE=life-stack-web
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
REGISTRATION_ENABLED=false
ENABLE_API_DOCS=true
ENABLE_DB_HEALTH_ROUTE=false

# External movie services
OMDB_API_KEY=
OPENAI_API_KEY=
OPENAI_MOVIE_MODEL=gpt-5.6-luna

# Session policy
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_TOKEN_IDLE_DAYS=7
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_ATTEMPTS=25
