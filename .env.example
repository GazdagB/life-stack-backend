# Application
DATABASE_URL=postgresql://user:password@localhost:5432/life_stack
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT_SECONDS=5
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=life-stack-api
JWT_AUDIENCE=life-stack-web
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
# Railway production example:
# ALLOWED_HOSTS=lifeos.gazdagbalazs.com,healthcheck.railway.app
REGISTRATION_ENABLED=false
ENABLE_API_DOCS=true
ENABLE_DB_HEALTH_ROUTE=false
# Public path used by the browser before Caddy removes the /api prefix.
PUBLIC_API_PREFIX=/api
# In Railway, the backend is private and only Caddy connects to it. Set this to
# * there so Uvicorn can use the client address forwarded by that trusted proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# External movie services
OMDB_API_KEY=
OPENAI_API_KEY=
OPENAI_MOVIE_MODEL=gpt-5.6-luna

# Read-only bank account synchronization (Enable Banking)
ENABLE_BANKING_APP_ID=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_DATA_ENCRYPTION_KEY=
ENABLE_BANKING_PRIVATE_KEY_PATH=/absolute/path/to/enable-banking-private.pem
# Alternative for hosted deployments: PEM content with escaped newlines. Prefer the path locally.
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_BASE_URL=https://api.enablebanking.com
ENABLE_BANKING_REDIRECT_URL=http://localhost:5173/expenses/bank-accounts/callback
ENABLE_BANKING_CONSENT_DAYS=89

# Session policy
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_TOKEN_IDLE_DAYS=7
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_ATTEMPTS=25
